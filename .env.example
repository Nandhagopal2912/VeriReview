# Copy to .env and adjust. Never commit .env.

# Runtime
VERIREVIEW_ENVIRONMENT=development
VERIREVIEW_LOG_LEVEL=INFO

# Database (used by the app and Alembic when running on the host).
# Port 5433 = the docker-compose Postgres (5432 is often taken by a local install).
VERIREVIEW_DATABASE_URL=postgresql+psycopg://verireview:verireview@localhost:5433/verireview

# GitHub. Optional: without it only public REST data is read and thread resolution is unknown.
# Use a fine-grained PAT with read-only access (Contents: read, Pull requests: read).
VERIREVIEW_GITHUB_TOKEN=

# GitHub App for advisory mode (Phase 11, docs/phase11_github_advisory.md). Leave empty unless
# you run the webhook service. Put the private key in a file outside the repository and point to
# it, or paste it with \n escapes. Never commit real values.
VERIREVIEW_GITHUB_APP_ID=
VERIREVIEW_GITHUB_APP_PRIVATE_KEY_PATH=
VERIREVIEW_GITHUB_WEBHOOK_SECRET=
VERIREVIEW_ADVISORY_CHECK_NAME=VeriReview

# Postgres container (docker-compose). Dev-only credentials.
POSTGRES_HOST_PORT=5433
POSTGRES_USER=verireview
POSTGRES_PASSWORD=verireview
POSTGRES_DB=verireview
